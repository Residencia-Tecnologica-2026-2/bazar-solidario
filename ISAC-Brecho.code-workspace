{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/dados": true,
      "**/.local-secrets.properties": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "ISAC: preparar ambiente (primeira vez)",
        "type": "shell",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./PREPARAR-AMBIENTE.ps1",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "ISAC: backend local",
        "type": "shell",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./INICIAR-BACKEND.ps1",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "ISAC: frontend",
        "type": "shell",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./INICIAR-FRONTEND.ps1",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "ISAC: iniciar aplicativo completo",
        "dependsOn": [
          "ISAC: backend local",
          "ISAC: frontend"
        ],
        "dependsOrder": "parallel",
        "problemMatcher": []
      },
      {
        "label": "ISAC: testes frontend",
        "type": "shell",
        "command": "npm test",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "problemMatcher": []
      },
      {
        "label": "ISAC: build frontend",
        "type": "shell",
        "command": "npm run build",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "problemMatcher": []
      },
      {
        "label": "ISAC: testes backend",
        "type": "shell",
        "command": ".\\mvnw.cmd test",
        "options": {
          "cwd": "${workspaceFolder}/backend"
        },
        "problemMatcher": []
      }
    ]
  }
}